# Server
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=change-me-dev-secret
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=10

# Database
DB_FILE=../data/auctions.sqlite

# External currency service
FX_BASE_URL=https://api.frankfurter.dev/v1
FX_TIMEOUT_MS=2000
FX_CACHE_TTL_MS=60000
FX_RETRIES=2

# Realtime
SSE_HEARTBEAT_MS=15000
SSE_BUFFER_SIZE=500

# Closing runner
CLOSER_SWEEP_INTERVAL_MS=1000