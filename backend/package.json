{
  "name": "auction-platform-backend",
  "version": "0.1.0",
  "description": "Real-Time Auction Platform backend (Tehnologii Web, tema 9, RTM + CON)",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1",
    "test:watch": "node --watch --test",
    "coverage": "c8 --all --include 'src/**' npm test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "supertest": "^7.1.4"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true
  }
}
